# Copy to .env locally. Never commit .env files.
# Local billing on the phone does not require any of these values.

# --- NestJS backend (apps/backend) ---
# DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice_gst
# JWT_SECRET=replace-with-at-least-32-random-characters
# PORT=3000
# CORS_ORIGINS=*
# NODE_ENV=development

# --- Mobile API client (cloud backup). Leave unset to hide backup UI. ---
# EXPO_PUBLIC_API_URL=http://192.168.1.8:3000
